{
  "manifest_version": 3,
  "name": "ContextIQ",
  "version": "1.0",
  "permissions": [
  "activeTab",
  "scripting",
  "sidePanel",
  "tabs"
],
  "action": {
    "default_icon": "icon.jpg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
  "<all_urls>",
  "http://localhost:8000/",
  "http://127.0.0.1:8000/"
]
}